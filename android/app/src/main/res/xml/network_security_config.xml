<?xml version="1.0" encoding="utf-8"?>
<!--
  Host agents on a trusted LAN speak plain HTTP, so cleartext is allowed at the
  platform layer. The clients enforce policy instead:
  - Cloud BYOK requires https except for loopback test servers.
  - Host connections allow http only for loopback, or for a LAN host when the
    user explicitly enables "Allow unencrypted LAN" in the host setup sheet.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
